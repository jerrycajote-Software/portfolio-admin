# Database connection (Neon PostgreSQL - https://console.neon.tech)
# DATABASE_URL = pooled connection string (host contains '-pooler')
# DIRECT_URL   = direct connection string (used by prisma migrate)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js secret
AUTH_SECRET="generate-with: npx auth secret"
AUTH_URL="http://localhost:3001"

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="portfolio-media"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Admin seed credentials (used by: npm run db:seed)
SEED_ADMIN_EMAIL="you@example.com"
SEED_ADMIN_PASSWORD="choose-a-strong-password"
